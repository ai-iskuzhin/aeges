<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aeges.Core\Aeges.Core.csproj" />
    <ProjectReference Include="..\Aeges.Application\Aeges.Application.csproj" />
    <ProjectReference Include="..\Aeges.Agent\Aeges.Agent.csproj" />
    <ProjectReference Include="..\Aeges.Storage\Aeges.Storage.csproj" />
    <ProjectReference Include="..\Aeges.Storage.Sqlite\Aeges.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\Aeges.Runners\Aeges.Runners.csproj" />
    <ProjectReference Include="..\Aeges.Runners.Codex\Aeges.Runners.Codex.csproj" />
    <ProjectReference Include="..\Aeges.Git\Aeges.Git.csproj" />
    <ProjectReference Include="..\Aeges.Telegram\Aeges.Telegram.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aeges</ToolCommandName>
    <PackageId>Aeges.Cli</PackageId>
    <Version>0.1.0-alpha.5</Version>
    <Authors>Aeges contributors</Authors>
    <Description>Reliable governed coding runtime CLI.</Description>
    <PackageProjectUrl>https://github.com/ai-iskuzhin/aeges</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ai-iskuzhin/aeges</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>aeges;cli;ai;coding-runtime;governance</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>../../.artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
